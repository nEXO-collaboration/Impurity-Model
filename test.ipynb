# Impurity Model for nEXO using TOUCAN

This notebook demonstrates the use of TOUCAN (Toolkit for Outgassing Contamination Analysis) to study the impact of electronegative impurities in certain environments, with a focus on the nEXO experiment. We'll go through a series of calculations and visual representations to understand this phenomenon better.

## Setup

First, let's import the necessary libraries and set up our plotting environment.

```python
import toucan as tc
import matplotlib.pyplot as plt
import numpy as np

# Set up plotting style
plt.style.use('seaborn')
plt.rcParams['figure.figsize'] = (12, 8)
plt.rcParams['font.size'] = 12
```

## 1. Modelling Outgassing of Impurities

### 1.1 Desorption from Stainless Steel

We'll start by modeling the desorption of impurities from stainless steel surfaces in the EXO-200 setup.

```python
# Define the system
exo_200_steel = tc.Outgassing_setup(
    setup="EXO-200",
    material="Stainless-Steel",
    solute="Oxygen",
    version="EXO-Stainless-Steel",
)

# Set time regions
steel_timestamps = tc.get_time_stamps(points=[1e-1, 1e4], spacing=1, time_scale="Hours")

print(exo_200_steel)

# Calculate outgassing rate
steel_flow_rates = exo_200_steel.get_steel_flow_rate_vs_pumping_time(
    time=steel_timestamps, unbaked_flow_rate=1e-8, initial_pumped_time=2600
)

# Plot results
plt.figure()
plt.plot([t / 3600 for t in steel_timestamps[0]], steel_flow_rates[0])
plt.xlabel("Time (hours)")
plt.ylabel("Outgassing Rate (mbar.l/s)")
plt.title("Stainless Steel Outgassing Rate in EXO-200")
plt.yscale("log")
plt.xscale("log")
plt.grid(True)
plt.show()
```

### 1.2 Outgassing from Plastics

Now, let's model the outgassing from plastic materials (Kapton and Teflon) in the nEXO setup.

```python
def model_plastic_outgassing(setup, material, solute, version, temperatures, time_points):
    # Define the system
    plastic_setup = tc.Outgassing_setup(setup=setup, material=material, solute=solute, version=version)
    
    plastic_setup.temperatures = temperatures
    plastic_setup.activation_energy = 0.47  # Example value, adjust as needed
    
    # Set time regions
    timestamps = tc.get_time_stamps(points=time_points, spacing=0.1, time_scale="Days")
    
    print(plastic_setup)
    
    # Calculate diffusion constants and initial impurities
    plastic_setup.get_diff_temp()
    plastic_setup.get_initial_impurities(units="#")
    
    # Calculate impurities and outgassing rates
    impurities = plastic_setup.get_impurities_vs_time(time=timestamps)
    flow_rates = plastic_setup.get_flow_rate_vs_time(time=timestamps, impurities=impurities, units="mBar Liter")
    
    return timestamps, impurities, flow_rates, plastic_setup

# Model Kapton
kapton_timestamps, kapton_impurities, kapton_flow_rates, nexo_kapton = model_plastic_outgassing(
    "nEXO", "Kapton", "Oxygen", "nEXO-Kapton", [293, 164], [1e-1, 1e2]
)

# Model Teflon
teflon_timestamps, teflon_impurities, teflon_flow_rates, nexo_teflon = model_plastic_outgassing(
    "EXO-200", "Teflon", "Oxygen", "EXO-Teflon", [293, 164], [0, 2, 20]
)

# Plot results
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(20, 8))

for i, (timestamps, impurities, flow_rates, setup) in enumerate([
    (kapton_timestamps, kapton_impurities, kapton_flow_rates, nexo_kapton),
    (teflon_timestamps, teflon_impurities, teflon_flow_rates, nexo_teflon)
]):
    for time_data, imp, flow, temp in zip(timestamps, impurities, flow_rates, setup.temperatures):
        label = f"{setup.material}, T={temp}K"
        ax1.plot(time_data, imp, label=label)
        ax2.plot(time_data, flow, label=label)

ax1.set_xlabel("Time (Days)")
ax1.set_ylabel("Total Number of Impurities")
ax1.set_yscale("log")
ax1.set_title("Impurities vs Time")
ax1.legend()

ax2.set_xlabel("Time (Days)")
ax2.set_ylabel("Outgassing Rate (mBar⋅Liter/s)")
ax2.set_yscale("log")
ax2.set_xscale("log")
ax2.set_title("Outgassing Rate vs Time")
ax2.legend()

plt.tight_layout()
plt.show()
```

## 2. Electron Lifetime Prediction

Finally, let's predict the electron lifetime evolution with different parameters in the nEXO system.

```python
# Define the system
nexo_electron_lifetime = tc.Outgassing_setup(
    setup="nEXO",
    material="Stainless-Steel",
    solute="Oxygen",
    version="EXO-Stainless-Steel",
)

# Set time regions
lifetime_timestamps = tc.get_time_stamps(points=[0, 60], spacing=1/24, time_scale="Days")

print(nexo_electron_lifetime)

# Define different out-diffusion rates
out_diffusion_values = [1, 0.1, 0.01]

# Calculate electron lifetimes
results = []
for out_diffusion in out_diffusion_values:
    lifetimes, params = nexo_electron_lifetime.get_electron_lifetime_vs_time(
        time=lifetime_timestamps,
        initial_impurities=1,
        circulation_rate=200/60,
        purification_efficiency=1,
        out_diffusion=out_diffusion,
    )
    results.append((lifetimes, params))

# Plot results
plt.figure()
time_in_days = [t / 86400 for t in lifetime_timestamps[0]]

for lifetimes, params in results:
    label = f"Out Diffusion = {params['out_diffusion']} ppb.l/s"
    plt.plot(time_in_days, lifetimes, label=label)

plt.xlabel("Time (days)")
plt.ylabel("Electron Lifetime (ms)")
plt.title("Electron Lifetime vs Time for Different Out-Diffusion Rates")
plt.yscale("log")
plt.legend()
plt.grid(True)
plt.show()
```

